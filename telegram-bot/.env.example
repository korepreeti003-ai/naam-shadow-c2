# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Comma-separated list of allowed Telegram chat IDs (leave blank = no restriction)
ALLOWED_CHAT_IDS=123456789,987654321

# Admin API key (must match backend ADMIN_API_KEY)
ADMIN_API_KEY=DEMO_ADMIN_KEY

# Backend URL
BACKEND_URL=http://localhost:3000

# Port for the internal notify server (backend calls this to push alerts)
NOTIFY_PORT=3001
