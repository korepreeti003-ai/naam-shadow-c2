#!/sbin/sh
SKIPUNZIP=1
unzip -o "$ZIPFILE" 'module.prop' -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'service.sh' -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'post-fs-data.sh' -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'shadowlocd' -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'zygisk/*' -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'system/*' -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'shadowloc.conf' -d "$MODPATH" >&2

chmod +x "$MODPATH/service.sh"
chmod +x "$MODPATH/post-fs-data.sh"
chmod +x "$MODPATH/shadowlocd"

# Default config if none exists
if [ ! -f /data/local/tmp/shadowloc.conf ]; then
    cp "$MODPATH/shadowloc.conf" /data/local/tmp/shadowloc.conf
    chmod 666 /data/local/tmp/shadowloc.conf
fi

ui_print "- Shadow Location Spoofer installed"
ui_print "- Edit /data/local/tmp/shadowloc.conf to set coordinates"
ui_print "- Reboot to activate"
