# ─── Firebase Admin (Service Account) ───────────────────────────────────────
# Download from: Firebase Console → Project Settings → Service Accounts
# Paste the full JSON content as a single line, or use a file path below
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# ─── Firebase Client Config (Public, safe to expose) ─────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Redis (for BullMQ job queue) ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Session ────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-random-256-bit-secret

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Admin Email Whitelist ───────────────────────────────────────────────────
# Comma-separated list of Firebase Auth emails allowed to access the dashboard
ADMIN_EMAILS=admin@example.com
